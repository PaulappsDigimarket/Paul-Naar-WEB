<script>
  (function() {
    // Discography filter logic
    const filterButtons = document.querySelectorAll('.filter-btn');
    const discoCards = document.querySelectorAll('.disco-card');

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Toggle active button style
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-primary-container', 'text-on-primary-container');
          btn.classList.add('text-on-surface-variant');
        });
        button.classList.add('bg-primary-container', 'text-on-primary-container');
        button.classList.remove('text-on-surface-variant');

        const filter = button.getAttribute('data-filter');
        discoCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Tracklist Play button handler
    const trackRows = document.querySelectorAll('.track-row');
    const masterPlayIcon = document.getElementById('master-play-icon');
    const playerTitle = document.getElementById('player-title');
    const totalTime = document.getElementById('total-time');

    trackRows.forEach(row => {
      row.addEventListener('click', (e) => {
        if (e.target.closest('.lyrics-trigger')) return;

        const name = row.getAttribute('data-track-name');
        const duration = row.getAttribute('data-track-time');
        
        playerTitle.textContent = name;
        totalTime.textContent = duration;

        // Reset all row play buttons
        trackRows.forEach(r => {
          r.classList.remove('bg-surface-container-high');
          const btn = r.querySelector('.track-play-btn');
          const icon = btn.querySelector('.material-symbols-outlined');
          btn.classList.remove('bg-primary-container', 'text-on-primary-container');
          btn.classList.add('bg-surface-container-highest', 'text-on-surface');
          icon.textContent = 'play_arrow';
        });

        // Set clicked row active
        row.classList.add('bg-surface-container-high');
        const activeBtn = row.querySelector('.track-play-btn');
        const activeIcon = activeBtn.querySelector('.material-symbols-outlined');
        activeBtn.classList.add('bg-primary-container', 'text-on-primary-container');
        activeBtn.classList.remove('bg-surface-container-highest', 'text-on-surface');
        activeIcon.textContent = 'pause';

        masterPlayIcon.textContent = 'pause';
      });
    });

    // Master play button toggle
    const masterPlayToggle = document.getElementById('master-play-toggle');
    if (masterPlayToggle) {
      masterPlayToggle.addEventListener('click', () => {
        if (masterPlayIcon.textContent === 'pause') {
          masterPlayIcon.textContent = 'play_arrow';
        } else {
          masterPlayIcon.textContent = 'pause';
        }
      });
    }

    // Lyrics Modal Handling
    const lyricsTriggers = document.querySelectorAll('.lyrics-trigger');
    const lyricsModal = document.getElementById('lyrics-modal');
    const closeLyrics = document.getElementById('close-lyrics');
    const closeLyricsBtn = document.getElementById('close-lyrics-btn');
    const modalSongTitle = document.getElementById('modal-song-title');

    function openModal(title) {
      if (modalSongTitle && title) modalSongTitle.textContent = title;
      lyricsModal.classList.remove('hidden');
      setTimeout(() => {
        lyricsModal.classList.remove('opacity-0');
      }, 10);
    }

    function closeModal() {
      lyricsModal.classList.add('opacity-0');
      setTimeout(() => {
        lyricsModal.classList.add('hidden');
      }, 300);
    }

    lyricsTriggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const row = trigger.closest('.track-row');
        const songName = row ? row.getAttribute('data-track-name') : 'Corazón de Rumbero';
        openModal(songName);
      });
    });

    if (closeLyrics) closeLyrics.addEventListener('click', closeModal);
    if (closeLyricsBtn) closeLyricsBtn.addEventListener('click', closeModal);

    if (lyricsModal) {
      lyricsModal.addEventListener('click', (e) => {
        if (e.target === lyricsModal) closeModal();
      });
    }
  })();
